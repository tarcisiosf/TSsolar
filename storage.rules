rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ADMIN_EMAIL_PLACEHOLDER" ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    // Logo da empresa: qualquer pessoa pode ver (aparece na proposta pública),
    // só o admin envia ou substitui o arquivo.
    match /company/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
